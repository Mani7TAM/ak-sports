---
import { formatMatchDate, outcomes, type Match } from '../lib/matches';

interface Props {
  match: Match['data'];
}
const { match } = Astro.props;
const result = match.result!;
const outcome = outcomes[result.outcome];
const details = [formatMatchDate(match), match.venue, match.tournament, match.format].filter(Boolean).join(' · ');
---

<article class="grid grid-cols-[auto_1fr] items-start gap-x-4 gap-y-1 py-4 sm:grid-cols-[auto_1fr_auto] sm:items-center">
  <span
    class={`flex h-10 w-10 items-center justify-center rounded-full font-display text-lg font-bold ${outcome.class}`}
    title={outcome.text}
  >
    <span aria-hidden="true">{outcome.short}</span>
    <span class="sr-only">{outcome.text}</span>
  </span>
  <div>
    <h3 class="font-display text-xl leading-tight font-bold text-brand-950 uppercase">vs {match.opponent}</h3>
    <p class="text-sm text-stone-500">{details}</p>
  </div>
  <div class="col-start-2 sm:col-start-auto sm:text-right">
    <p class="text-sm text-stone-600 tabular-nums">
      <span class="font-semibold text-stone-800">{result.ourScore ?? '–'}</span>{' '}
      <span class="text-stone-400">v</span>{' '}{result.theirScore ?? '–'}
    </p>
    <p class="text-sm font-semibold text-brand-800">
      {result.summary}
      {
        match.cricheroesUrl && (
          <>
            {' · '}
            <a href={match.cricheroesUrl} target="_blank" rel="noopener" class="text-brand-600 hover:underline">
              Scorecard
            </a>
          </>
        )
      }
    </p>
  </div>
</article>
