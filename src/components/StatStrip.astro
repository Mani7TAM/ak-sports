---
interface Props {
  items: { value: string | number; label: string }[];
}
const { items } = Astro.props;
---

<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-stone-200 bg-stone-200 sm:grid-cols-4">
  {
    items.map((s) => (
      <div class="flex flex-col-reverse bg-white p-5 text-center">
        <dt class="text-sm font-medium text-stone-500">{s.label}</dt>
        <dd class="font-display text-4xl font-bold text-brand-800 tabular-nums">{s.value}</dd>
      </div>
    ))
  }
</dl>
